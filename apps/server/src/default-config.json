{
  "shell": {
    "macos": {
      "command": null,
      "cwd": "~"
    },
    "linux": {
      "command": null,
      "cwd": "~"
    },
    "windows": {
      "command": null,
      "cwd": "~"
    }
  },
  "font": {
    "family": "FiraCode Nerd Font",
    "size": 14,
    "lineHeight": 1.35,
    "ligatures": true
  },
  "cursor": {
    "style": "block",
    "blink": true
  },
  "padding": {
    "top": 4,
    "right": 4,
    "bottom": 4,
    "left": 6
  },
  "scrollback": 10000,
  "theme": {
    "name": "one-dark-darker",
    "boldIsBright": true
  },
  "emptyScreenAnimation": false,
  "behavior": {
    "modernizeShiftEnter": true,
    "pasteBrowserImages": true,
    "showGitBranch": true,
    "captureShortcuts": true,
    "bellFlash": true,
    "bellSound": true,
    "terminalIdentity": "sshtty"
  }
}
