---
import type { GithubIcon } from '@hugeicons/core-free-icons'
import { HugeiconsIcon } from '@hugeicons/react'

interface Props {
  icon: typeof GithubIcon
  title: string
  class: string
}

const { icon, title, class: className } = Astro.props
---

<div class:list={['border-line px-6 py-10 md:px-10 md:py-12', className]}>
  <HugeiconsIcon icon={icon} className="size-5" />
  <h3 class="mt-5 font-medium">{title}</h3>
  <p class="text-muted mt-2 leading-relaxed"><slot /></p>
</div>
