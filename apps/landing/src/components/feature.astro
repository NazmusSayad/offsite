---
import type { GithubIcon } from '@hugeicons/core-free-icons'
import { HugeiconsIcon } from '@hugeicons/react'

interface Props {
  icon: typeof GithubIcon
  title: string
  text: string
}

const { icon, title, text } = Astro.props
---

<li class="flex gap-4">
  <HugeiconsIcon icon={icon} className="mt-0.5 size-5 shrink-0" />
  <p class="text-muted leading-relaxed">
    <span class="text-foreground font-medium">{title}.</span>{' '}
    {text}
  </p>
</li>
