---
import { ArrowLeftRightIcon } from '@hugeicons/core-free-icons'
import { HugeiconsIcon } from '@hugeicons/react'
---

<div
  class="relative flex h-12 items-center justify-center md:h-auto md:w-20"
>
  <span
    class="bg-line absolute inset-y-0 left-1/2 w-px md:inset-x-0 md:inset-y-auto md:top-1/2 md:h-px md:w-auto"
  ></span>
  <span
    class="bg-background text-muted relative grid size-7 place-items-center rounded-full"
  >
    <HugeiconsIcon
      icon={ArrowLeftRightIcon}
      className="size-4 rotate-90 md:rotate-0"
    />
  </span>
</div>
