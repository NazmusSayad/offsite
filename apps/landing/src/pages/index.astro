---
import '../index.css'
import {
  ArrowTurnBackwardIcon,
  ChatGptIcon,
  ComputerTerminal01Icon,
  Download01Icon,
  Folder01Icon,
  GitPullRequestIcon,
  GithubIcon,
  LockKeyIcon,
  Notification01Icon,
  ServerStack01Icon,
} from '@hugeicons/core-free-icons'
import { HugeiconsIcon } from '@hugeicons/react'
import Cell from '../components/cell.astro'
import Connector from '../components/connector.astro'
import { CopyCommand } from '../components/copy-command'
import Feature from '../components/feature.astro'
import Provider from '../components/provider.astro'
import { ClaudeIcon, OpenCodeIcon } from '../icons'

const GITHUB_URL = 'https://github.com/NazmusSayad/offsite'
---

<html lang="en">
  <head>
    <title>OffSite: Claude Code, Codex and OpenCode in your browser</title>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Claude Code, Codex and OpenCode in your browser. It uses the same sessions as their CLIs, so you can start in one and resume in the other."
    />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="overflow-x-clip">
      <header
        class="border-line bg-background/70 sticky top-0 z-20 border-b backdrop-blur-md"
      >
        <div
          class="mx-auto flex h-14 max-w-6xl items-center justify-between px-6"
        >
          <a
            href="/"
            class="flex items-center gap-2.5 font-semibold tracking-tight"
          >
            <img src="/icon.svg" alt="" class="size-6" />
            OffSite
          </a>
          <a
            href={GITHUB_URL}
            class="text-muted hover:text-foreground flex items-center gap-2 text-sm transition-colors"
          >
            <HugeiconsIcon icon={GithubIcon} className="size-4" />
            GitHub
          </a>
        </div>
      </header>

      <main class="border-line mx-auto max-w-6xl border-x">
        <section class="relative">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 -top-14 h-[44rem] bg-[radial-gradient(ellipse_55%_50%_at_50%_0%,rgb(255_255_255/11%),transparent)]"
          >
          </div>
          <div class="relative px-6 pt-20 pb-14 md:px-12 md:pt-28">
            <h1
              class="fade-up max-w-4xl text-[2.75rem] leading-[1.02] font-semibold tracking-[-0.045em] text-balance md:text-7xl"
            >
              Claude Code, Codex and OpenCode.{' '}
              <span class="text-muted">In your browser.</span>
            </h1>
            <p
              class="fade-up text-muted mt-6 max-w-xl text-lg leading-relaxed [animation-delay:80ms]"
            >
              OffSite runs on your machine and opens the same sessions as the
              CLIs. Start a task in the terminal, carry on in a browser tab, and
              switch back whenever you like.
            </p>
            <div
              class="fade-up mt-10 flex flex-wrap items-center gap-3 [animation-delay:160ms]"
            >
              <CopyCommand client:load />
              <a
                href={GITHUB_URL}
                class="border-line hover:bg-surface flex h-11 items-center gap-2 rounded-full border px-5 text-sm font-medium transition-colors"
              >
                <HugeiconsIcon icon={GithubIcon} className="size-4" />
                View on GitHub
              </a>
            </div>
          </div>
          <div
            class="fade-up relative px-3 pb-16 [animation-delay:240ms] md:px-12 md:pb-24"
          >
            <div
              class="border-line bg-surface rounded-2xl border p-1.5 shadow-[0_40px_160px_-40px_rgb(255_255_255/18%)] md:p-2"
            >
              <img
                src="/app-coding.webp"
                width={2880}
                height={1800}
                alt="OffSite with a Claude Code thread open next to the thread list"
                class="aspect-[4/3] rounded-xl object-cover object-left-top md:aspect-auto"
              />
            </div>
          </div>
        </section>

        <section
          class="border-line divide-line grid divide-y border-t md:grid-cols-3 md:divide-x md:divide-y-0"
        >
          <Provider name="Claude Code" command="claude">
            <ClaudeIcon className="size-6" />
          </Provider>
          <Provider name="Codex" command="codex">
            <HugeiconsIcon icon={ChatGptIcon} className="size-6" />
          </Provider>
          <Provider name="OpenCode" command="opencode">
            <OpenCodeIcon className="h-6" />
          </Provider>
        </section>

        <section class="border-line border-t px-6 py-20 md:px-12 md:py-28">
          <h2
            class="max-w-2xl text-3xl font-semibold tracking-[-0.035em] md:text-5xl"
          >
            One history, two ways in.
          </h2>
          <p class="text-muted mt-5 max-w-2xl text-lg leading-relaxed">
            OffSite doesn&apos;t keep its own copy of your conversations. It
            reads each provider&apos;s sessions directly, so a thread you start
            in the terminal is already in the browser, and one you start in the
            browser resumes in the CLI.
          </p>

          <div
            class="mt-14 flex flex-col items-stretch md:flex-row md:items-center"
          >
            <div class="border-line bg-surface rounded-xl border p-5 md:w-64">
              <p
                class="text-subtle text-xs font-medium tracking-wide uppercase"
              >
                Terminal
              </p>
              <p class="mt-3 font-mono text-sm">
                <span class="text-subtle">$</span> claude
              </p>
            </div>
            <Connector />
            <div
              class="relative flex-1 rounded-xl border border-white/25 bg-white/[0.04] p-5 shadow-[0_0_60px_-12px_rgb(255_255_255/18%)]"
            >
              <p
                class="text-subtle text-xs font-medium tracking-wide uppercase"
              >
                Session history
              </p>
              <p class="mt-3 text-sm">Kept by Claude Code, Codex or OpenCode</p>
            </div>
            <Connector />
            <div class="border-line bg-surface rounded-xl border p-5 md:w-64">
              <p
                class="text-subtle text-xs font-medium tracking-wide uppercase"
              >
                Browser
              </p>
              <p class="mt-3 flex items-center gap-2 text-sm">
                <img src="/icon.svg" alt="" class="size-4" />
                OffSite
              </p>
            </div>
          </div>
        </section>

        <section class="border-line grid border-t md:grid-cols-[5fr_7fr]">
          <div class="px-6 py-20 md:px-12 md:py-24">
            <h2 class="text-3xl font-semibold tracking-[-0.035em] md:text-5xl">
              The rest of your desk, too.
            </h2>
            <p class="text-muted mt-5 text-lg leading-relaxed">
              The chat sits next to the tools you&apos;d otherwise switch
              windows for.
            </p>
            <ul class="mt-10 space-y-6">
              <Feature
                icon={ComputerTerminal01Icon}
                title="Terminal"
                text="Run commands in a real terminal under the chat."
              />
              <Feature
                icon={GitPullRequestIcon}
                title="Git"
                text="Review diffs, commit, switch branches and open pull requests."
              />
              <Feature
                icon={Folder01Icon}
                title="Files"
                text="Browse the project and preview any file."
              />
              <Feature
                icon={ArrowTurnBackwardIcon}
                title="Rewind and fork"
                text="Edit an earlier message, restore code, or fork from any reply."
              />
            </ul>
          </div>
          <div
            class="border-line relative min-h-80 overflow-hidden border-t md:border-t-0 md:border-l"
          >
            <img
              src="/app-terminal.webp"
              width={2880}
              height={1800}
              alt="OffSite with the terminal panel open under a thread"
              class="absolute top-12 left-10 h-[calc(100%-3rem)] w-[calc(100%-2.5rem)] rounded-tl-xl border-t border-l border-white/10 object-cover object-[47%_100%] md:top-16 md:left-14 md:h-[calc(100%-4rem)] md:w-[calc(100%-3.5rem)]"
            />
          </div>
        </section>

        <section class="border-line border-t">
          <div class="px-6 pt-20 pb-14 md:px-12 md:pt-28">
            <h2
              class="max-w-2xl text-3xl font-semibold tracking-[-0.035em] md:text-5xl"
            >
              Check in from anywhere.
            </h2>
            <p class="text-muted mt-5 max-w-xl text-lg leading-relaxed">
              The whole app fits a phone screen, so a long task doesn&apos;t
              keep you at your desk.
            </p>
          </div>
          <div class="border-line grid border-t md:grid-cols-3 md:grid-rows-2">
            <div
              class="border-line relative h-96 overflow-hidden border-b bg-[radial-gradient(ellipse_70%_60%_at_50%_100%,rgb(255_255_255/9%),transparent)] md:row-span-2 md:h-auto md:border-r md:border-b-0"
            >
              <img
                src="/app-mobile.webp"
                width={1179}
                height={1977}
                alt="OffSite on a phone, showing a thread and the message box"
                class="absolute top-10 left-1/2 w-60 -translate-x-1/2 rounded-[2rem] border-4 border-[#1c1c1c] shadow-2xl"
              />
            </div>
            <Cell
              icon={Download01Icon}
              title="Install it as an app"
              class="md:border-r md:border-b"
            >
              Start with <code class="text-foreground font-mono">--pwa</code> and
              add OffSite to your home screen. It opens offline too.
            </Cell>
            <Cell
              icon={Notification01Icon}
              title="Notifications"
              class="border-t md:border-t-0 md:border-b"
            >
              Get a push when an agent or a terminal needs you, even with no
              OffSite tab open.
            </Cell>
            <Cell
              icon={ServerStack01Icon}
              title="More than one machine"
              class="border-t md:border-t-0 md:border-r"
            >
              Pair your laptop and your desktop, and switch between them from
              the sidebar.
            </Cell>
            <Cell
              icon={LockKeyIcon}
              title="Paired browsers only"
              class="border-t md:border-t-0"
            >
              Only browsers that opened a pairing link can connect. Remove one
              any time with
              <code class="text-foreground font-mono">offsite unpair</code>.
            </Cell>
          </div>
        </section>

        <section
          class="border-line relative overflow-hidden border-t px-6 py-24 text-center md:py-32"
        >
          <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-x-0 bottom-0 h-full bg-[radial-gradient(ellipse_50%_70%_at_50%_100%,rgb(255_255_255/8%),transparent)]"
          >
          </div>
          <h2
            class="relative text-4xl font-semibold tracking-[-0.04em] md:text-6xl"
          >
            Start with one command.
          </h2>
          <p
            class="text-muted relative mx-auto mt-5 max-w-md text-lg leading-relaxed"
          >
            Run it, then open the pairing link it prints. Your agents are one
            tab away.
          </p>
          <div class="relative mt-10 flex justify-center">
            <CopyCommand client:load />
          </div>
          <dl
            class="border-line bg-surface/60 relative mx-auto mt-16 grid max-w-2xl gap-x-8 gap-y-3 rounded-xl border p-6 text-left text-sm sm:grid-cols-[auto_1fr]"
          >
            <dt class="font-mono">offsite</dt>
            <dd class="text-muted">Starts the server and the web app</dd>
            <dt class="font-mono">offsite serve</dt>
            <dd class="text-muted">Starts only the server</dd>
            <dt class="font-mono">offsite pair</dt>
            <dd class="text-muted">Makes a pairing link for another browser</dd>
            <dt class="font-mono">offsite unpair</dt>
            <dd class="text-muted">Picks a paired browser to remove</dd>
          </dl>
        </section>
      </main>

      <footer class="border-line border-t">
        <div
          class="text-subtle mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-8 text-sm"
        >
          <span class="flex items-center gap-2.5">
            <img src="/icon.svg" alt="" class="size-5" />
            MIT License · Nazmus Sayad
          </span>
          <a href={GITHUB_URL} class="hover:text-foreground transition-colors">
            github.com/NazmusSayad/offsite
          </a>
        </div>
      </footer>
    </div>
  </body>
</html>
