---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['frame', className]}>
  <div
    class="flex h-9 items-center gap-3 border-b border-white/8 bg-[#0d1014] px-4"
  >
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="size-2.5 rounded-full bg-white/12"></span>
      <span class="size-2.5 rounded-full bg-white/12"></span>
      <span class="size-2.5 rounded-full bg-white/12"></span>
    </span>
    <span
      class="text-subtle mx-auto rounded-md bg-white/5 px-16 py-0.5 font-mono text-[11px]"
    >
      127.0.0.1:47841
    </span>
  </div>
  <slot />
</div>
