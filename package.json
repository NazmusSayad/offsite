{
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm --filter web build && pnpm --filter server build",
    "start": "node apps/server/dist/main.js",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "pnpm typecheck && oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "pnpm --filter web test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxfmt": "^0.27.0",
    "eslint-plugin-react": "^7.37.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  }
}
