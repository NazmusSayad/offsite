{
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r exec tsc",
    "lint": "pnpm typecheck && oxlint .",
    "lint:fix": "oxlint . --fix && oxfmt",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "dev": "OFFSITE_CONNECT=http://127.0.0.1:37842 pnpm --filter server --filter client --parallel dev",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "web": "pnpm --filter web dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxfmt": "^0.30.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
