{
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r exec tsc",
    "lint": "pnpm typecheck && oxlint .",
    "lint:fix": "oxlint . --fix && oxfmt",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "dev": "node scripts/dev.mts",
    "build": "pnpm --filter client build && pnpm --filter server build",
    "web": "pnpm --filter web dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-oxfmt": "^0.30.0",
    "eslint-plugin-react": "^7.37.5",
    "get-port": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "react-icons": "^5.7.0"
  }
}
